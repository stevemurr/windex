#!/usr/bin/python3
"""Rewrite the NVIDIA CDI spec into a form podman 4.9.3 can actually read.

`nvidia-cdi-refresh.service` runs `nvidia-ctk cdi generate` on every boot and on
every driver change, writing /var/run/cdi/nvidia.yaml at **cdiVersion 0.7.0**.
podman 4.9.3 cannot parse 0.7.0, so the only spec it can use is a 0.6.0 copy at
/etc/cdi/nvidia.yaml — which, being hand-maintained, goes stale and breaks the
GPU containers in two different ways:

  * driver upgrade  -> stale .so paths        ("failed to fulfil mount request")
  * plain reboot    -> stale /dev/dri/cardN   ("failed to stat CDI host device")

The second one is why this exists: DRI node numbering is not stable across boots
(observed card1 -> card0 on 2026-07-24 with the driver unchanged), so pinning a
hand-patched file does not survive. Deriving /etc/cdi from the freshly generated
/var/run copy on every boot makes both classes of staleness structurally
impossible — we never edit device paths, we only downgrade the schema.

The 0.7.0 -> 0.6.0 downgrade is exactly two edits:
  * cdiVersion: 0.7.0 -> 0.6.0
  * drop the `additionalGids:` blocks (a 0.7.0-only field, and what forces 0.7.0
    in the first place). Dropping those GIDs is proven fine on this box.

Writes /run/windex-cdi-ready on success; windex-models.service waits on that
stamp before starting GPU containers. /run is tmpfs, so the stamp cannot survive
a reboot and go falsely positive.

Exits non-zero only when it would otherwise install something broken: no source
spec, or a transform that no longer parses. In those cases the existing
/etc/cdi/nvidia.yaml is left untouched.
"""
import os
import sys
import tempfile

import yaml

SRC = "/var/run/cdi/nvidia.yaml"
DST = "/etc/cdi/nvidia.yaml"
STAMP = "/run/windex-cdi-ready"
TARGET_VERSION = "0.6.0"


def log(msg):
    print(f"nvidia-cdi-downconvert: {msg}", flush=True)


def downconvert(text):
    """0.7.0 -> 0.6.0, line-wise.

    Deliberately textual rather than yaml.safe_load + yaml.dump: a round-trip
    would reflow the whole document (key order, quoting, the `- ../card0::/dev/...`
    symlink entries), making any future diff against the generated spec useless.
    Here the output differs from the input only on the lines we mean to change.
    """
    out, gids_indent = [], None
    for line in text.splitlines(keepends=True):
        stripped = line.lstrip()
        indent = len(line) - len(stripped)
        if gids_indent is not None:
            # Inside an additionalGids block: its list items are indented deeper.
            if stripped.startswith("-") and indent > gids_indent:
                continue
            gids_indent = None
        if stripped.startswith("additionalGids:"):
            gids_indent = indent
            continue
        if stripped.startswith("cdiVersion:"):
            out.append(f"{' ' * indent}cdiVersion: {TARGET_VERSION}\n")
            continue
        out.append(line)
    return "".join(out)


def main():
    if not os.path.exists(SRC):
        log(f"FATAL {SRC} missing — is nvidia-cdi-refresh.service healthy?")
        return 1

    with open(SRC) as fh:
        source = fh.read()
    result = downconvert(source)

    # Validate before installing: a spec that does not parse is worse than a
    # stale one, because podman falls back to "unresolvable CDI devices".
    try:
        doc = yaml.safe_load(result)
    except yaml.YAMLError as exc:
        log(f"FATAL transform produced invalid YAML, keeping existing {DST}: {exc}")
        return 1
    if not isinstance(doc, dict) or "devices" not in doc:
        log(f"FATAL transform produced an unexpected document, keeping existing {DST}")
        return 1
    if str(doc.get("cdiVersion")) != TARGET_VERSION:
        log(f"FATAL cdiVersion is {doc.get('cdiVersion')!r}, expected {TARGET_VERSION}")
        return 1
    if "additionalGids" in result:
        log("FATAL additionalGids survived the transform (0.7.0-only field)")
        return 1

    # Advisory only. The source was generated by nvidia-ctk from the live system
    # seconds ago, so a missing node more likely means an exotic setup than a bug
    # — and a fresh spec still beats the stale one we would be keeping. Loud in
    # the journal either way, because this is the exact shape of the reboot bug.
    missing = sorted({
        node["path"]
        for dev in doc.get("devices", [])
        for node in (dev.get("containerEdits", {}) or {}).get("deviceNodes", []) or []
        if node.get("path") and not os.path.exists(node["path"])
    })
    if missing:
        log(f"WARNING referenced device nodes do not exist: {', '.join(missing)}")

    devices = [d.get("name") for d in doc.get("devices", [])]
    if os.path.exists(DST) and open(DST).read() == result:
        log(f"{DST} already current ({TARGET_VERSION}, devices: {', '.join(map(str, devices))})")
    else:
        os.makedirs(os.path.dirname(DST), exist_ok=True)
        # Atomic: podman may be reading DST while we install. Same filesystem so
        # os.replace is a rename, never a truncate-and-write.
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(DST), prefix=".nvidia.yaml.")
        try:
            with os.fdopen(fd, "w") as fh:
                fh.write(result)
            os.chmod(tmp, 0o644)
            os.replace(tmp, DST)
        except BaseException:
            os.unlink(tmp)
            raise
        log(f"wrote {DST} at {TARGET_VERSION} (devices: {', '.join(map(str, devices))})")

    with open(STAMP, "w") as fh:
        fh.write(f"{DST} {TARGET_VERSION}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
